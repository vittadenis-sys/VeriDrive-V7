{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veridrive-v7",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://wdddcacijkpixuvxcrje.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "",
    "SUPABASE_URL": "",
    "FOO_TEST": ""
  },
  "secrets": {
    "required": ["SUPABASE_SERVICE_ROLE_KEY"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
